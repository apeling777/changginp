<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>경찰청 범죄주의구간 세이프맵</title>
    <script src="https://cdn.rawgit.com/openlayers/openlayers.github.io/master/en/v5.3.0/build/ol.js"></script>
    <link rel="stylesheet" href="https://cdn.rawgit.com/openlayers/openlayers.github.io/master/en/v5.3.0/css/ol.css">
</head>
<body>
    <div id="map" style="width: 100%; height: 600px;"></div>

    <script>
        var baseMap = new ol.layer.Tile({
            source: new ol.source.OSM()
        });

        var wmsLayer = new ol.layer.Tile({
            source: new ol.source.TileWMS({
                url: 'http://safemap.go.kr/openapi2/IF_0087_WMS',
                params: {
                    'serviceKey': 'HTMM1RG9-HTMM-HTMM-HTMM-HTMM1RG9OW',
                    'LAYERS': 'A2SM_CRMNLHSPOT_TOT',
                    'STYLES': 'A2SM_CrmnlHspot_Tot_Tot',
                    'FORMAT': 'image/png',
                    'TRANSPARENT': true
                },
                serverType: 'geoserver'
            })
        });

        var map = new ol.Map({
            target: 'map',
            layers: [baseMap, wmsLayer],
            view: new ol.View({
                center: ol.proj.fromLonLat([126.9786567, 37.566826]),
                zoom: 12
            })
        });
    </script>
</body>
</html>
